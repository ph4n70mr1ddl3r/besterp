{
  "name": "besterp",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-first ERP built on Silverstone's universal data models",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace=@besterp/database",
    "db:generate": "npm run generate --workspace=@besterp/database",
    "db:seed": "npm run seed --workspace=@besterp/database",
    "db:reset": "npm run reset --workspace=@besterp/database",
    "db:cleanup": "tsx packages/database/scripts/cleanup-expired-idempotency.ts",
    "spike:rls": "npm run spike:rls --workspace=@besterp/database",
    "spike:mcp": "npm run spike:agent --workspace=@besterp/mcp-tools"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "typescript-eslint": "^8.60.1"
  }
}
