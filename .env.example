# BestERP — Environment

# Application mode (development, staging, production)
NODE_ENV=development

# Application role (non-superuser, subject to RLS)
# IMPORTANT: RLS does NOT work with superuser roles!
DATABASE_URL="postgresql://besterp_app:CHANGEME_APP_PASSWORD@localhost:5434/besterp"

# PostgreSQL superuser password (used by docker-compose.yml)
POSTGRES_PASSWORD=CHANGEME_ADMIN_PASSWORD

# Admin/migration role (superuser, bypasses RLS for migrations)
DATABASE_ADMIN_URL="postgresql://besterp:CHANGEME_ADMIN_PASSWORD@localhost:5434/besterp"

# Redis (for BullMQ queues, caching, sessions)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=besterp_minio
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD

# API server
PORT=3000

# CORS origins (comma-separated list of allowed origins)
# Unset/empty is NOT wide-open: in development it falls back to a restrictive
# localhost allowlist (http://localhost:3000/3001/5173/5174); in every other
# environment an empty value aborts startup. Required in staging/production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT secret — MUST be changed in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Leave empty in development — a random ephemeral secret is generated per session.
# WARNING: Never leave this empty in staging, preview, or production environments.
JWT_SECRET=

# JWT token expiry duration (e.g., "24h", "7d", "1h")
# Defaults to "24h" if not set. Rejected at boot: zero-leading values ("0s",
# "007d") and lifetimes longer than 30 days (MAX_JWT_EXPIRES_IN_DAYS).
# JWT_EXPIRES_IN=24h

# Rate limiting — sliding window configuration (optional)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_PER_WINDOW=300

# Trust proxy hops (optional, default: 0 = disabled)
# Number of reverse-proxy / load-balancer hops in front of this app. Set to the
# number of proxies (e.g. 1 for a single LB) so the rate limiter keys on the
# real client IP instead of the proxy IP. Every proxy in front MUST overwrite
# inbound X-Forwarded-For headers; if the app is directly reachable and this is
# enabled, a client can forge the header and bypass IP-based rate limiting.
# TRUST_PROXY_HOPS=1

# JWT issuer — validates the `iss` claim in tokens (off by default)
# JWT_ISSUER=besterp

# JWT audience — validates the `aud` claim in tokens (off by default)
# JWT_AUDIENCE=besterp-api

# Redis TLS — enable TLS for Redis connections (default: true in non-dev)
# REDIS_TLS=1

# Build metadata (visible in /health/version in non-production)
# BUILD_NUMBER=
# BUILD_DATE=

# Graceful shutdown timeout in milliseconds (default: 10000)
# HARD_EXIT_TIMEOUT_MS=10000

# Prisma tenant-client cache tuning (optional)
# PRISMA_MAX_METHOD_CACHE_SIZE=1000
# PRISMA_MAX_DELEGATE_CACHE_SIZE=50

# Cleanup: transaction timeout for idempotency cleanup script (ms, default: 600000)
# CLEANUP_TX_TIMEOUT_MS=600000

# Cleanup: allow running idempotency cleanup against production (safety opt-in)
# ALLOW_CLEANUP_PRODUCTION=0

# Seed: allow running db:seed (safety opt-in; NEVER enable against production)
# ALLOW_SEED=0
