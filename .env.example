# BestERP Phase 0b — Environment

# Application role (non-superuser, subject to RLS)
# IMPORTANT: RLS does NOT work with superuser roles!
DATABASE_URL="postgresql://besterp_app:besterp_app_dev@localhost:5434/besterp"

# Admin/migration role (superuser, bypasses RLS for migrations)
DATABASE_ADMIN_URL="postgresql://besterp:besterp_dev@localhost:5434/besterp"

# Redis (for BullMQ queues, caching, sessions)
REDIS_HOST=localhost
REDIS_PORT=6380

# API server
PORT=3000

# CORS origins (comma-separated, leave empty for wide-open dev mode)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT secret — MUST be changed in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=besterp-dev-secret-change-me
