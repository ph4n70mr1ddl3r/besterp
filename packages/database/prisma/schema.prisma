// BestERP — Core Party Schema (Silverstone Ch. 1-2)
// Phase 0a Spike: Validate Prisma + RLS + Class Table Inheritance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant Management ──────────────────────────────────────────
// The "tenant" is just an ORGANIZATION party. We use a convenience
// view/table for tenant lookup but the real isolation is RLS.

// ─── Type Tables (AI-facing, shared across tenants) ─────────────

model PartyType {
  partyTypeId  String   @id @default(uuid()) @map("party_type_id")
  parentTypeId String?  @map("parent_type_id")
  name         String   @unique
  description  String
  aiPromptHint String?  @map("ai_prompt_hint")
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")

  // Self-referencing hierarchy
  parentType PartyType?  @relation("PartyTypeHierarchy", fields: [parentTypeId], references: [partyTypeId])
  childTypes PartyType[] @relation("PartyTypeHierarchy")

  parties Party[]

  @@index([parentTypeId])
  @@map("party_type")
}

// ─── Supertype: PARTY ───────────────────────────────────────────

model Party {
  partyId     String   @id @default(uuid()) @map("party_id")
  partyTypeId String   @map("party_type_id")
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  version     Int      @default(1) @map("version")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Type relation
  partyType PartyType @relation(fields: [partyTypeId], references: [partyTypeId])

  // Subtype relations (1:1 — at most one will be populated)
  person       Person?
  organization Organization?

  // Roles
  roles PartyRole[]

  // Contact mechanisms
  partyContacts PartyContactMechanism[]

  // Auth user (one-to-one, null for non-human parties)
  user User?

  @@index([tenantId])
  @@index([partyTypeId])
  @@index([tenantId, partyTypeId])
  // pg_trgm GIN index added in migration 20260619000000 (party_name_trgm_idx).
  // For large production tables, consider running CREATE INDEX CONCURRENTLY manually.
  @@map("party")
}

// ─── Subtype: PERSON ────────────────────────────────────────────

model Person {
  partyId    String    @id @map("party_id")
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  middleName String?   @map("middle_name")
  birthDate  DateTime? @map("birth_date")
  gender     String?

  party Party @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("person")
}

// ─── Subtype: ORGANIZATION ──────────────────────────────────────

model Organization {
  partyId          String    @id @map("party_id")
  legalName        String    @map("legal_name")
  taxId            String?   @map("tax_id")
  registrationDate DateTime? @map("registration_date")

  party Party @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("organization")
}

// ─── Party Role ─────────────────────────────────────────────────

model RoleType {
  roleTypeId   String   @id @default(uuid()) @map("role_type_id")
  name         String   @unique
  description  String
  aiPromptHint String?  @map("ai_prompt_hint")
  parentTypeId String?  @map("parent_type_id")
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")

  parentType RoleType?  @relation("RoleTypeHierarchy", fields: [parentTypeId], references: [roleTypeId])
  childTypes RoleType[] @relation("RoleTypeHierarchy")

  partyRoles PartyRole[]

  @@index([parentTypeId])
  @@map("role_type")
}

model PartyRole {
  partyRoleId String    @id @default(uuid()) @map("party_role_id")
  partyId     String    @map("party_id")
  roleTypeId  String    @map("role_type_id")
  fromDate    DateTime  @default(now()) @map("from_date")
  thruDate    DateTime? @map("thru_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  party    Party    @relation(fields: [partyId], references: [partyId], onDelete: Cascade)
  roleType RoleType @relation(fields: [roleTypeId], references: [roleTypeId], onDelete: Restrict)

  @@index([partyId])
  @@index([roleTypeId])
  @@index([partyId, roleTypeId])
  @@index([fromDate])
  @@index([thruDate])
  @@map("party_role")
}

// ─── Contact Mechanism ──────────────────────────────────────────

model ContactMechanismType {
  contactMechanismTypeId String   @id @default(uuid()) @map("contact_mechanism_type_id")
  name                   String   @unique
  description            String
  aiPromptHint           String?  @map("ai_prompt_hint")
  createdAt              DateTime @default(now()) @map("created_at")

  contactMechanisms ContactMechanism[]

  @@map("contact_mechanism_type")
}

model ContactMechanism {
  contactMechanismId     String   @id @default(uuid()) @map("contact_mechanism_id")
  contactMechanismTypeId String   @map("contact_mechanism_type_id")
  tenantId               String   @map("tenant_id")
  createdAt              DateTime @default(now()) @map("created_at")

  contactMechanismType ContactMechanismType    @relation(fields: [contactMechanismTypeId], references: [contactMechanismTypeId])
  partyContacts        PartyContactMechanism[]
  postalAddress        PostalAddress?
  telecomNumber        TelecomNumber?
  emailAddress         EmailAddress?

  @@index([tenantId])
  @@map("contact_mechanism")
}

model PartyContactMechanism {
  partyContactMechanismId String    @id @default(uuid()) @map("party_contact_mechanism_id")
  partyId                 String    @map("party_id")
  contactMechanismId      String    @map("contact_mechanism_id")
  fromDate                DateTime  @default(now()) @map("from_date")
  thruDate                DateTime? @map("thru_date")

  party            Party            @relation(fields: [partyId], references: [partyId], onDelete: Cascade)
  contactMechanism ContactMechanism @relation(fields: [contactMechanismId], references: [contactMechanismId], onDelete: Cascade)

  @@index([partyId])
  @@index([contactMechanismId])
  @@map("party_contact_mechanism")
}

// Contact subtypes

model PostalAddress {
  contactMechanismId String  @id @map("contact_mechanism_id")
  addressLine1       String  @map("address_line_1")
  addressLine2       String? @map("address_line_2")
  city               String
  stateProvince      String? @map("state_province")
  postalCode         String? @map("postal_code")
  country            String

  contactMechanism ContactMechanism @relation(fields: [contactMechanismId], references: [contactMechanismId], onDelete: Cascade)

  @@map("postal_address")
}

model TelecomNumber {
  contactMechanismId String  @id @map("contact_mechanism_id")
  tenantId           String  @map("tenant_id")
  countryCode        String  @default("+1") @map("country_code")
  areaCode           String  @map("area_code")
  lineNumber         String  @map("line_number")
  extension          String?

  contactMechanism ContactMechanism @relation(fields: [contactMechanismId], references: [contactMechanismId], onDelete: Cascade)

  // DB-level backstop for the service-layer duplicate check (same rationale
  // as EmailAddress @@unique below). Added in migration 20260819000003.
  @@unique([tenantId, countryCode, areaCode, lineNumber])
  @@map("telecom_number")
}

model EmailAddress {
  contactMechanismId String @id @map("contact_mechanism_id")
  email              String
  tenantId           String @map("tenant_id")

  contactMechanism ContactMechanism @relation(fields: [contactMechanismId], references: [contactMechanismId], onDelete: Cascade)

  @@index([email])
  @@unique([tenantId, email])
  @@map("email_address")
}

// ─── AI Action Log ──────────────────────────────────────────────

model AiActionLog {
  id             String   @id @default(uuid()) @map("id")
  agentId        String?  @map("agent_id")
  conversationId String?  @map("conversation_id")
  userId         String   @map("user_id")
  tenantId       String   @map("tenant_id")
  toolCalled     String   @map("tool_called")
  toolInput      Json     @map("tool_input")
  toolOutput     Json?    @map("tool_output")
  reasoning      String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, toolCalled])
  @@index([userId])
  @@index([agentId])
  @@index([conversationId])
  @@map("ai_action_log")
}

// ─── Idempotency Record ─────────────────────────────────────────

enum IdempotencyStatus {
  pending
  completed
  failed
}

model IdempotencyRecord {
  // Idempotency keys are TENANT-SCOPED, not globally unique. A composite
  // primary key on (idempotencyKey, tenantId) is required: otherwise two
  // tenants that happen to reuse the same key (very common — clients emit
  // sequential or hash-derived keys) collide on a global PK violation when
  // the second tenant inserts, surfacing as a misleading
  // IDEMPOTENCY_CONTENTION error instead of working correctly.
  idempotencyKey String    @map("idempotency_key")
  toolName       String    @map("tool_name")
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  agentId        String?   @map("agent_id")
  conversationId String?   @map("conversation_id")
  status         IdempotencyStatus @default(pending)
  inputHash      String    @map("input_hash")
  result         Json?
  error          Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([tenantId])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([toolName])
  @@id([idempotencyKey, tenantId])
  @@map("idempotency_record")
}

// ─── Entity Descriptor ──────────────────────────────────────────
// AI-facing descriptions for every core entity. Populates the
// `describe_entity` discovery tool so agents can introspect the schema
// without reading raw Prisma output. Shared across tenants.

model EntityDescriptor {
  entityName      String   @id @map("entity_name")
  description     String
  aiPromptHint    String?  @map("ai_prompt_hint")
  keyFields       Json?    @map("key_fields")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("entity_descriptor")
}

// ─── Confirmation Gate ──────────────────────────────────────────
// Tracks which tools require agent confirmation before execution.
// High/critical risk tools are enforced here; admin-curated values.
// Global (non-tenant) reference data.

model ConfirmationGate {
  toolName      String   @id @map("tool_name")
  enabled       Boolean  @default(true) @map("enabled")
  description   String
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("confirmation_gate")
}

// ─── Agent Registry ─────────────────────────────────────────────
// Per-tenant AI agent registry. Each agent is scoped to a tenant and
// carries capabilities, rate limits, and financial restrictions.
// Implements AGENTIC_AI_DESIGN.md §8.1 (Agent Registry).

model AgentRegistry {
  agentId                         String   @id @map("agent_id")
  tenantId                        String   @map("tenant_id")
  displayName                     String   @map("display_name")
  description                     String
  capabilities                    Json     @map("capabilities")
  maxToolCallsPerConversation     Int      @default(100) @map("max_tool_calls_per_conversation")
  maxConcurrentConversations      Int      @default(5)  @map("max_concurrent_conversations")
  maxTransactionAmount            Decimal? @default(0) @map("max_transaction_amount")
  allowedEntityTypes              Json     @default("[]") @map("allowed_entity_types")
  rateLimitPerMinute              Int      @default(30) @map("rate_limit_per_minute")
  version                         String
  isActive                        Boolean  @default(true) @map("is_active")
  createdAt                       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("agent_registry")
}

// ─── User ───────────────────────────────────────────────────────
// Human user account linked to a PARTY (Silverstone Ch. 1-2).
// The party carries the identity; this row carries auth-specific data.
// Implements ERP_PLAN.md Phase 0c: core-security.

model User {
  userId     String   @id @map("user_id")
  partyId    String   @unique @map("party_id")
  tenantId   String   @map("tenant_id")
  passwordHash String @map("password_hash")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  party Party @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@unique([tenantId, partyId])
  @@index([tenantId])
  @@map("user")
}
