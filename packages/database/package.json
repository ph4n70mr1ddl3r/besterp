{
  "name": "@besterp/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "spike:rls": "tsx spikes/spike-rls.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@besterp/shared": "*",
    "@prisma/client": "^6.8.0"
  },
  "devDependencies": {
    "prisma": "^6.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
